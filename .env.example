# Local development only. Run: docker compose up -d db
# Leave DATABASE_URL unset if you only want guest favorites and demo scores.
DATABASE_URL=postgresql://sideline:local_dev_password@127.0.0.1:5432/sideline

# Set the exact HTTPS origin in production, especially behind a reverse proxy.
APP_ORIGIN=http://localhost:3000

# Server-only secret. Empty means clearly labeled demo mode.
API_SPORTS_KEY=

# Example competitions/seasons: verify current provider IDs and subscription access.
FOOTBALL_LEAGUE_ID=39
FOOTBALL_SEASON=2026
BASKETBALL_LEAGUE_ID=12
BASKETBALL_SEASON=2026-2027
BASEBALL_LEAGUE_ID=1
BASEBALL_SEASON=2026
